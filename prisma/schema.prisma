// =============================
// CLIENTS (B2C)
// =============================
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Customer {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  lastName      String?
  firstName     String?
  telephone     String?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
